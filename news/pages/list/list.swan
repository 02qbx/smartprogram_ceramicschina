<view class="container">
    <view class="darkgrey">
   <import src="/template/mune/mune.swan" /> 
        
        <!-- list -->
        <view class="white newslist shadow">
            <view class="n-list">
                <view class="t">
                    <view class="left">{{proclass}}</view>
                 
                </view>
                <view class="list">
                    <view class="list-con"  s-for="{{list}}" s-for-item="item">
                        <navigator url="/news/pages/view/view?id={{item.pg_news.id}}" >
                            <view class="left">
                                <image mode="widthFix" src="https://img1.ceramicschina.com/{{item.pg_news.ispic}}"></image>
                            </view>
                            <view class="right">
                                <view class="title">{{item.pg_news.news_title}}</view>
                                <view class="n-bottom">
                                    <view class="time">{{item.pg_news.make_date}}</view>
                                   <!-- <view class="read">{{item.pg_news.click_n}}</view>-->
                                </view>
                            </view>
                        </navigator>
                    </view>
                   
                      
                </view>
                  <view  bindtap="loadMore" data-hash='{{pageid}}'  class="btn-more">点击加载</view>
            </view>
        </view>
        <view class="footer">
            <view>经营许可证编号：粤ICP备14052601号-1</view>
            <view class="foot">© 2002-2018&nbsp;中国陶瓷网 All Rights Reserved</view>
        </view>
    </view>
</view>