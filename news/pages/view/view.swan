<import src="../../../wxParse/wxParse.swan"/>
<view>
    <!-- 在页面中对自定义组件进行引用 -->
    <custom chinaName="中国陶瓷网" engName="Custom title"></custom>
</view>
<view class="container">
    <import src="/template/mune/mune.swan" />
        <!-- content -->
    <view class="white newsview">
        <view class="art_title">{{pg_news.newsTitle}}</view>
        <view class="tit">
            <view>{{pg_news.reTitle}}</view>
            <view>{{pg_news.newsFrom}}</view>
            <view>{{pg_news.makeDate}}</view>
        </view>
        <view class="art_content">
           <text><template is="wxParse" data="{{{wxParseData.nodes}}}"/></text>
        </view>

            <!-- 广告位 -->
        <navigator class="ad" url="/pages/index/index" >
            <image mode="widthFix" src="/images/1.jpg"></image>
            <view class="gg">广告</view>
        </navigator>

        <!-- 头条推荐 -->
        <view class="newslist">
            <view class="title">头条推荐</view>
            <view class="news-con">
                <block s-for="{{list}}" s-for-item="item">
                    <navigator url="/news/pages/view/view?id={{item.id}}" >{{item.newsTitle}}</navigator>
                </block>
            </view>
        </view>
        <!-- 头条推荐 -->
    </view>

    <view class="pinglun">
        <view class="title">评论列表</view>
        <!-- 评论列表组件 -->
        <comment-list
    comment-param="{{commentParam}}"
    detail-path="{{detailPath}}"
    toolbar-config="{{toolbarConfig}}"
    bindclickcomment="clickComment">
</comment-list>

    </view>

</view>
<view class="page-section-btns" bindtap="scrollToTop">
    <view class="ToTop">
        <image mode="widthFix" src="/images/ztw_retopbtn.png" alt="返回顶部"></image>
    </view>
</view>

