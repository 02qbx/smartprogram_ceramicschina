<!-- 自定义组件内部的模板 (custom.swan) -->
<view class="nav-box">
    <view class="top-title" style="height:{{statusBarHeight*2+100}}rpx">
        <!-- <view class="back-icon-wrap" bindtap="back">
            <image class="back-icon" src="/images/back-w.png"></image>
        </view>
        <view class="home-icon-wrap">
            <navigator url="/pages/index/index" open-type="redirect">
                <image class="back-icon" src="/images/ztw_shouye.png"></image>
            </navigator>
        </view> -->
        <view class="topbar white page-title" style="padding-top:{{statusBarHeight+10}}rpx">
            <navigator class="logo" url="/pages/index/index" open-type="redirect">
                <image mode="aspectFit" src="/images/logo-w.png"></image>
            </navigator>
        </view>
    </view>
</view>

<!-- 占位元素，防止接下来的页面内容被导航栏遮挡 -->
<view style="padding-top:{{statusBarHeight*2+100}}rpx"></view>
