
<view>
    <!-- 在页面中对自定义组件进行引用 -->
    <custom chinaName="中国陶瓷网" engName="Custom title"></custom>
</view>

<view class="container">
        <import src="/template/mune/mune.swan" />
        <!-- <import src="/template/IndexMune/IndexMune.swan" /> -->
        <!-- ad -->

        <view class="wrap adv">
            <swiper
                controls="{{!canIUse}}"
                indicator-dots="false"
                autoplay="true"
                interval="3000"
                duration="1200"
                circular="true"
                style="height:386rpx;  width:100%; "
                current="{{swiperCurrent}}"
                bindchange="swiperChangeCustom"
            >

                <block  s-for="{{ad}}" s-for-item="p">
                    <swiper-item class="row-view" >
                        <navigator url="/news/pages/view/view?id={{p.id}}" >
                            <image mode="widthFix" bindtap="slideAction" src="https://img1.ceramicschina.com/{{p.ispic}}"></image>
                            <view class="title">{{p.id}}</view>
                        </navigator>
                    </swiper-item >
                </block>
            </swiper>
            <view class="dots">
                <view s-for="{{ad}}" class="dot {{index == swiperCurrent ? ' active' : ''}}"></view>
            </view>
        </view>
        <view class="red tips-none">投资有风险，加盟需谨慎</view>

        <!-- hotnews -->
        <view class="section ind_hot">
            <view class="n_list">
                <view class="news-hot">
                    <block  s-for="{{piclist}}" s-for-item="p">
                    <view class="n_con">
                        <navigator open-type="navigate" url="/news/pages/view/view?id={{p.pg_news.id}}" class="n_title">{{p.pg_news.newsTitle}}</navigator>
                        <view class="info">
                            <text>{{p.pg_newclass.proclass}}</text>
                            <text>{{p.pg_news.clickN}}阅读</text>
                        </view>
                    </view>
                    </block>


                </view>
            </view>
        </view>

        <!-- brand -->
        <view class="section brand-set">
            <view class="n_list content">
                <view class="t ind-title">
                    <view class="left">
                        <navigator open-type="navigate" url="">十大品牌推荐</navigator>
                    </view>
                </view>
                <view class="brandlist">

                        <view url-query-name="position" class="swiper-tab">

                            <block s-for="{{pinpai_all}}" s-for-item="item" s-for-index="idx">
                            <view class="tab-item {{currentBrand==idx ? 'on' : ''}}" data-current="{{idx}}" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/index/index?typename={{item.pinpaitypeenname}}">{{item.pinpaitypename}}</navigator></view>
                            </block>

                        </view>
                        <swiper class="swiper" current="{{currentBrand}}" duration="200" bindchange="swiperChange" style="height:330rpx;">
                              <block s-for="{{pinpai_all}}" s-for-item="it" >
                            <swiper-item>
                                <block s-for="{{it.pg_pinpaidata}}" s-for-item="item">
                                <view class="imgbox"><navigator open-type="navigate" url="/bangdan/pages/view/view?id={{item.digestid}}" target="_blank" title=" {{item.pg_pinpaidigest.pinpainame}}"><image  mode="widthFix" src="https://img1.ceramicschina.com{{item.pg_pinpaidigest.pinpailogo}}" alt=" {{item.pg_pinpaidigest.pinpainame}}" ></image></navigator></view>
                                </block>

                            </swiper-item>
                            </block>

                        </swiper>
                        <text class="text-right">滑动更多》》》</text>
                </view>
            </view>
        </view>

        <!-- newslist -->
        <view class="section">
            <view class="ind-title tit-fixed">
                <view class="left">
                    <navigator open-type="navigate" url="/news/pages/index/index">推荐</navigator>
                </view>
                <view class="ind-titRight">
                    <navigator open-type="navigate" url="/news/pages/list/list?id=959">行业热点</navigator>
                    <navigator open-type="navigate" url="/news/pages/list/list?id=973">人物访谈</navigator>
                    <navigator open-type="navigate" url="/news/pages/list/list?id=999">企业要闻</navigator>
                    <navigator open-type="navigate" url="/news/pages/list/list?id=974">中陶原创</navigator>
                </view>
            </view>
            <view class="n_list ind-news ind-con">
                <view class="news-hot-pic col_two">
                     <block s-for="{{toplist}}" s-for-item="item">
                    <view class="n_con">
                        <navigator url="/news/pages/view/view?id={{item.id}}" class="imgbox">
                            <image mode="widthFix" src="https://img1.ceramicschina.com/{{item.ispic}}"></image>
                        </navigator>
                        <view class="news-c">
                            <navigator url="/news/pages/view/view?id={{item.id}}" class="n_title">{{item.newsTitle}}</navigator>
                        </view>
                    </view>
                    </block>

                </view>
                <view class="list news-hot">
                        <view class="n_con"  s-for="{{list}}" s-for-item="item">
                                <view class="newsleft">
                                    <navigator url="/news/pages/view/view?id={{item.id}}" class="n_title">{{item.newsTitle}}
                                    </navigator>
                                    <view class="info">
                                        <text class="time">{{item.makeDate}}</text>
                                    <!-- <text class="read">{{item.click_n}}</text>-->
                                    </view>
                                </view>
                                <view class="imgbox">
                                    <navigator url="/news/pages/view/view?id={{item.id}}" >
                                        <image mode="widthFix" src="https://img1.ceramicschina.com/{{item.ispic}}"></image>
                                    </navigator>
                                </view>
                        </view>
                    <view class="checkmore">
                        <navigator url="/news/pages/index/index" class="btnss ind_btn">查看更多资讯&gt;</navigator>
                    </view>
                </view>
            </view>
        </view>

