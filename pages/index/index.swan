                        </navigator>
                        <view class="news-c">
                            <navigator url="https://m.ceramicschina.com/PG_ViewNews_124644.html">江西高安将诞生首家“30亿级”陶企</navigator>
                        </view>
                    </view>
                </view>
                <view class="list news-hot">
                        <view class="n_con"  s-for="{{list}}" s-for-item="item">
                                <view class="newsleft">
                                    <navigator url="/news/pages/view/view?id={{item.id}}" class="n_title">{{item.newsTitle}}
                                    </navigator>
                                    <view class="info">
                                        <text class="time">{{item.makeDate}}</text>
                                    <!-- <text class="read">{{item.click_n}}</text>-->
                                    </view>
                                </view>
                                <view class="imgbox">
                                    <navigator url="/news/pages/view/view?id={{item.id}}" >
                                        <image mode="widthFix" src="https://img1.ceramicschina.com/{{item.ispic}}"></image>
                                    </navigator>
                                </view>
                        </view>
                    <view class="checkmore">
                        <navigator url="" class="btnss ind_btn">查看更多资讯&gt;</navigator>
                    </view>
                </view>
            </view>
        </view>

