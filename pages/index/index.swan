                    <navigator open-type="navigate" url="">中陶原创</navigator>
                </view>
            </view>
            <view class="n_list ind-news ind-con">
                <view class="news-hot-pic col_two">
                    <view class="n_con">
                        <navigator url="https://m.ceramicschina.com/PG_ViewNews_124645.html" class="imgbox">
                            <image mode="widthFix" src="https://img1.ceramicschina.com//Upfiles/2020-11-11/2020111111210473156.jpg"></image>
                        </navigator>
                        <view class="news-c">
                            <navigator url="https://m.ceramicschina.com/PG_ViewNews_124645.html" class="n_title">【案例】简约X至美 遇见属于自己的生活</navigator>
                        </view>
                    </view>
                    <view class="n_con">
