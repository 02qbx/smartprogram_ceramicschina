
<view>
    <!-- 在页面中对自定义组件进行引用 -->
    <custom chinaName="中国陶瓷网" engName="Custom title"></custom>
</view>

<view class="container">
        <import src="/template/mune/mune.swan" />
        <import src="/template/IndexMune/IndexMune.swan" />
        <!-- ad -->

        <view class="wrap adv">
            <swiper
                controls="{{!canIUse}}"
                indicator-dots="false"
                autoplay="true"
                interval="3000"
                duration="1200"
                circular="true"
                style="height:386rpx;  width:100%; "
                current="{{swiperCurrent}}"
                bindchange="swiperChangeCustom"
            >

                <block  s-for="{{ad}}" s-for-item="p">
                    <swiper-item class="row-view" >
                        <navigator url="/news/pages/view/view?id={{p.id}}" >
                            <image mode="widthFix" bindtap="slideAction" src="https://img1.ceramicschina.com/{{p.ispic}}"></image>
                        </navigator>
                    </swiper-item >
                </block>
            </swiper>
            <view class="dots">
                <view s-for="{{ad}}" class="dot {{index == swiperCurrent ? ' active' : ''}}"></view>
            </view>
        </view>
        <view class="red tips-none">投资有风险，加盟需谨慎</view>

        <!-- hotnews -->
        <view class="section ind_hot">
            <view class="n_list">
                <view class="news-hot">
                    <view class="n_con">
                        <navigator open-type="navigate" url="" class="n_title">雄安新区瓷砖采购潮起！建陶企业的机会来了</navigator>
                        <view class="info">
                            <text>行业热点</text>
                            <text>1325阅读</text>
                        </view>
                    </view>
                    <view class="n_con">
                        <navigator open-type="navigate" url="" class="n_title">雄安新区瓷砖采购潮起！建陶企业的机会来了</navigator>
                        <view class="info">
                            <text>品牌资讯</text>
                            <text>1325阅读</text>
                        </view>
                    </view>
                    <view class="n_con">
                        <navigator open-type="navigate" url="" class="n_title">用这10套产品测试话术卖瓷砖，价值蹭蹭往上涨！</navigator>
                        <view class="info">
                            <text>终端调研</text>
                            <text>1358阅读</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>

        <!-- brand -->
        <view class="section brand-set">
            <view class="n_list content">
                <view class="t ind-title">
                    <view class="left">
                        <navigator open-type="navigate" url="">十大品牌推荐</navigator>
                    </view>
                </view>
                <view class="brandlist">

                        <view url-query-name="position" class="swiper-tab">
                            <view class="tab-item {{currentBrand==0 ? 'on' : ''}}" data-current="0" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/taocishidapinpai/taocishidapinpai">陶瓷十大品牌</navigator></view>

                            <view class="tab-item {{currentBrand==1 ? 'on' : ''}}" data-current="1" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/cizhuanshidapinpai/cizhuanshidapinpai">瓷砖十大品牌</navigator></view>

                            <view class="tab-item {{currentBrand==2 ? 'on' : ''}}" data-current="2" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/weiyushidapinpai/weiyushidapinpai">卫浴十大品牌</navigator></view>

                            <view class="tab-item {{currentBrand==3 ? 'on' : ''}}" data-current="3" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/taociyixian/taociyixian">陶瓷一线品牌</navigator></view>

                            <view class="tab-item {{currentBrand==4 ? 'on' : ''}}" data-current="4" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/dalishishidapinpai/dalishishidapinpai">大理石瓷砖十大品牌</navigator></view>

                            <view class="tab-item {{currentBrand==5 ? 'on' : ''}}" data-current="5" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/fangguzhuan/fangguzhuan">仿古砖十大品牌</navigator></view>

                            <view class="tab-item {{currentBrand==6 ? 'on' : ''}}" data-current="6" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/xiandaizhuanshidapinpai/xiandaizhuanshidapinpai">现代砖十大品牌</navigator></view>

                            <view class="tab-item {{currentBrand==7 ? 'on' : ''}}" data-current="7" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/muwenzhuanshidapinpai/muwenzhuanshidapinpai">木纹砖十大品牌</navigator></view>

                            <view class="tab-item {{currentBrand==8 ? 'on' : ''}}" data-current="8" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/cipian/cipian">瓷片十大品牌</navigator></view>

                            <view class="tab-item {{currentBrand==9 ? 'on' : ''}}" data-current="9" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/gongnengcizhuan/gongnengcizhuan">功能砖十大品牌</navigator></view>

                            <view class="tab-item {{currentBrand==10 ? 'on' : ''}}" data-current="10" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/shejishituijian/shejishituijian">设计师推荐品牌</navigator></view>

                            <view class="tab-item {{currentBrand==11 ? 'on' : ''}}" data-current="11" bindtap="swiperNav"><navigator open-type="navigate" url="/bangdan/pages/gongchengtuijianpinpai/gongchengtuijianpinpai">工程推荐品牌</navigator></view>
                        </view>
                        <swiper class="swiper" current="{{currentBrand}}" duration="200" bindchange="swiperChange" style="height:330rpx;">
                            <swiper-item>
                                <view class="imgbox"><navigator open-type="navigate" url="https://www.ceramicschina.com/pinpai/viewpinpai_8118.html" target="_blank" title="威尔斯陶瓷"><image  mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2018-12-13/20181213092408.jpg" alt="威尔斯陶瓷" ></image></navigator></view>

