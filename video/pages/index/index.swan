<import src="../../../wxParse/wxParse.swan"/>

<view>
    <!-- 在页面中对自定义组件进行引用 -->
    <custom chinaName="中国陶瓷网" engName="Custom title"></custom>
</view>

<import src="/template/mune/mune.swan" />

<view class="nav-top">
    <view class="topnavlist">
        <navigator bindtap="switchTab" hover-stop-propagation="true" class="cur">视频首页</navigator>
        <navigator url="/video/pages/list/list?id=1">瓷砖宝典</navigator>
        <navigator url="/video/pages/list/list?id=3">品牌之窗</navigator>
        <navigator url="/video/pages/list/list?id=2">人物专访</navigator>
    </view>
</view>

<view class="container">
    <!--to do-->
    <view class="section">
        <view class="ind-title tit-fixed">
            <view class="ind-titLeft">热门推荐</view>
            <view class="ind-titRight"></view>
        </view>
        <view class="col_11 video main_con">
            <view class="con"  s-for="{{videoindex}}" s-for-item="item">
                <navigator class="imgbox" openType="navigate" url="/video/pages/view/view?id={{item.id}}">
                    <image mode="widthFix" src="https://img1.ceramicschina.com/{{item.bigpic}}" alt="{{item.title}}"></image>

                </navigator>
                <navigator openType="navigate" url="/video/pages/view/view?id={{item.id}}" class="tit">{{item.title}}</navigator>
            </view>

        </view>
    </view>

    <view class="section">
        <view class="ind-title tit-fixed">
            <view class="ind-titLeft">瓷砖宝典</view>
            <view class="ind-titRight">
                <navigator openType="navigate" url="/video/pages/list/list?id=1">查看更多>></navigator>
            </view>
        </view>
        <view class="col_11 video main_con">
            <view class="con"  s-for="{{videoindex1}}" s-for-item="item">
                 <navigator class="imgbox" openType="navigate" url="/video/pages/view/view?id={{item.pg_video.id}}">
                    <image mode="widthFix" src="https://img1.ceramicschina.com/{{item.pg_video.bigpic}}" alt="{{item.pg_video.title}}"></image>

                </navigator>
                <navigator openType="navigate" url="/video/pages/view/view?id={{item.pg_video.id}}" class="tit">{{item.pg_video.title}}</navigator>
            </view>
        </view>
    </view>

    <view class="section">
        <view class="ind-title tit-fixed">
            <view class="ind-titLeft">品牌之窗</view>
            <view class="ind-titRight">
                <navigator openType="navigate" url="/video/pages/list/list?id=3">查看更多>></navigator>
            </view>
        </view>
        <view class="col_11 video main_con">
            <view class="con"  s-for="{{videoindex3}}" s-for-item="item">
                 <navigator class="imgbox" openType="navigate" url="/video/pages/view/view?id={{item.pg_video.id}}">
                    <image mode="widthFix" src="https://img1.ceramicschina.com/{{item.pg_video.bigpic}}" alt="{{item.pg_video.title}}"></image>

                </navigator>
                <navigator openType="navigate" url="/video/pages/view/view?id={{item.pg_video.id}}" class="tit">{{item.pg_video.title}}</navigator>
            </view>

        </view>
    </view>

    <view class="section">
        <view class="ind-title tit-fixed">
            <view class="ind-titLeft">人物专访</view>
            <view class="ind-titRight">
                <navigator openType="navigate" url="/video/pages/list/list?id=2">查看更多>></navigator>
            </view>
        </view>
        <view class="col_11 video main_con">
           <view class="con"  s-for="{{videoindex2}}" s-for-item="item">
                 <navigator class="imgbox" openType="navigate" url="/video/pages/view/view?id={{item.pg_video.id}}">
                    <image mode="widthFix" src="https://img1.ceramicschina.com/{{item.pg_video.bigpic}}" alt="{{item.pg_video.title}}"></image>

                </navigator>
                <navigator openType="navigate" url="/video/pages/view/view?id={{item.pg_video.id}}" class="tit">{{item.pg_video.title}}</navigator>
            </view>
        </view>
    </view>

</view>