<import src="../../../wxParse/wxParse.swan"/>

<view>
    <!-- 在页面中对自定义组件进行引用 -->
    <custom chinaName="中国陶瓷网" engName="Custom title"></custom>
</view>

<view class="container">
    <view class="wrap">
        <view class="video-wrap">
            <video
                style="width: 100%;"
                id="myVideo"
                src="{{video.video}}"
               >
            </video>
        </view>
    </view>
    <view class="section">
        <view class="vid-con">
            <view class="title">{{video.title}}</view>
            <view class="con">
                <view class="playnum">{{video.clickN}}</view>
                <view class="time">{{video.makeDate}}</view>
            </view>
        </view>
    </view>
    <view class="pinglun">
        <view class="float-title">- 全部评论 -</view>
        <!-- 评论列表组件 -->
        <comment-list
            comment-param="{{commentParam}}"
            detail-path="{{detailPath}}"
            toolbar-config="{{toolbarConfig}}"
            bindclickcomment="clickComment">
        </comment-list>
    </view>


</view>