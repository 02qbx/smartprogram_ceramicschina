               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=174">
                   <view class="pp_name">马可波罗磁砖</view>
                   <view class="pp_con">马可波罗瓷砖，企业创立于1988年，品牌诞生于1996年。作为国内最早品牌化、产品系列最全最大的建陶品牌</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=174" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=200">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2016-03-21/20160321025856.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=200">
                   <view class="pp_name">特兰托陶瓷</view>
                   <view class="pp_con">特兰托陶瓷，是集研发、生产、销售与服务为一体的木纹砖品牌。品牌定位于简约、自然的北欧风格，产品设计源于北欧的橡木、松木、枫木、云杉等天然珍稀木材</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=200" class="joinbtn">加盟</navigator>
