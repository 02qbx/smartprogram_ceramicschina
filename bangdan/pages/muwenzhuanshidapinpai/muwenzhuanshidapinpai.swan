   <view class="brandlist n_list col_12">

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=198">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2015-02-03/20150203040114.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=198">
                   <view class="pp_name">蒙娜丽莎瓷砖</view>
                   <view class="pp_con">蒙娜丽莎是建筑陶瓷文化艺术的领军品牌，拥有我国目前唯一 一座蒙娜丽莎主题文化艺术馆，同时也将全球蒙娜丽莎文化界首座全面引入薄板陶瓷艺术作品的艺术馆</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=198" class="joinbtn">加盟</navigator>
           </view>
       </view>

