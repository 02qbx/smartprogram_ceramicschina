               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=6501">
                   <view class="pp_name">TOTO卫浴</view>
                   <view class="pp_con">东陶公司是一个生产、销售民用及商业设施用卫浴、洁具及相关设备的厂家。追求高品质、高工艺水平，使用户享受卫生、健康、舒适的生活是公司一贯追求的目标</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=6501" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=86">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-18/20200518103244.png"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=86">
                   <view class="pp_name">恒通卫浴</view>
                   <view class="pp_con">福建南安市恒通卫浴有限公司创建于2002年，位于中国三大卫浴基地之一中国•南安，公司总部位于扶茂岭工业园区，占地面积130000平方米，建筑面积90000平方米，同时在漳州设立全资子公司，并注资和控股多家配套工厂，形成较大规模的卫浴集群企业</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=86" class="joinbtn">加盟</navigator>
           </view>
       </view>

