   <!-- list 卫浴十大品牌 -->
   <view class="tenbrandint">
       <view class="title">卫浴十大品牌</view>
       <view class="int">中国卫浴十大品牌榜是由中国陶瓷网和中国建筑装饰协会于2020年6月18日陶瓷品牌日共同线上揭幕，获得年度卫浴十大品牌榜的品牌有:九牧厨卫、TOTO卫浴、恒通卫浴、浪鲸卫浴、辉煌厨卫、恒洁卫浴、科勒卫浴、惠达卫浴、帝王洁具、欧路莎卫浴。（以上排名不分前后）</view>
   </view>

   <!-- bangdan -->
   <view class="brandlist n_list col_12">

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=74">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2015-01-15/20150115045114.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=74">
                   <view class="pp_name">九牧厨卫</view>
                   <view class="pp_con">Jomoo九牧是中国高端卫浴领导者,自主研发生产卫生陶瓷、智能厨卫、整体卫浴、厨卫家具、五金龙头、厨卫五金、九牧晾品等全线产品,以高品质及好服务著称,超过3万销售网点,提供一流厨卫解决方案</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=74" class="joinbtn">加盟</navigator>
           </view>
       </view>

