   <!-- list 大理石瓷砖十大品牌 -->
   <view class="tenbrandint">
       <view class="title">大理石瓷砖十大品牌</view>
       <view class="int">中国大理石瓷砖十大品牌榜是由中国陶瓷网和中国建筑装饰协会于2020年6月18日陶瓷品牌日共同线上揭幕，获得年度大理石瓷砖十大品牌榜的品牌有:简一大理石瓷砖、大角鹿超耐磨大理石瓷砖、新濠大理石瓷砖、欧朗格陶瓷、新罗玛陶瓷、伊美洛陶瓷。（以上排名不分前后）</view>
   </view>

   <!-- bangdan -->
   <view class="brandlist n_list col_12">

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=148">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2016-03-19/20160319111133.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=148">
                   <view class="pp_name">简一大理石瓷砖</view>
                   <view class="pp_con">佛山市简一陶瓷有限公司（以下简称“简一”）创建于2002年，是大理石瓷砖品类的开创者与领导者，秉承“大道至简 一以贯之”的发展理念，致力于为追求高品质生活的人们提供高端大理石瓷砖。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=148" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=111">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-25/20200525041740.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=111">
                   <view class="pp_name">大角鹿超耐磨大理石瓷砖</view>
                   <view class="pp_con">大角鹿独创“超耐磨钻石釉”专利技术有效提升大理石瓷砖的耐磨性，大角鹿超耐磨大理石瓷砖，超耐磨，持久新！</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=111" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=238">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-28/20200528114358.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=238">
                   <view class="pp_name">新濠大理石瓷砖</view>
                   <view class="pp_con">新濠大理石瓷砖始创于2011年，是广东昊晟企业旗下强势建筑陶瓷品牌，以专注的大理石瓷砖生产为依托，致力于打造 “工程集采渠道的大理石瓷砖首选品牌“，致力于为广大年轻消费者打造时尚潮流的家居生活空间。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=238" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=7569">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2019-04-26/20190426033208.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=7569">
                   <view class="pp_name">欧朗格陶瓷</view>
                   <view class="pp_con">欧朗格吸收中外最先进的设计理念与生产工艺，注重品牌、创新、质量与服务，以精益求精的态度和完善的产品线牢牢把握瓷砖家居市场的主流。欧朗格紧跟行业潮流，生产领先产品，以质量上乘、花色新颖、种类齐全、性价比高、服务完善、信誉可靠等优势获得陶瓷市场的广泛认可。</view>
               </navigator>
