   <!-- list 瓷砖十大品牌 -->
   <view class="tenbrandint">
       <view class="title">瓷砖十大品牌</view>
       <view class="int">中国瓷砖十大品牌榜是由中国陶瓷网和中国建筑装饰协会于2020年6月18日陶瓷品牌日共同线上揭幕，获得年度瓷砖十大品牌榜的品牌有:亚细亚瓷砖、大角鹿超耐磨大理石瓷砖、金意陶瓷砖、金牌亚洲磁砖、汇亚磁砖、新润成瓷砖、东鹏瓷砖、裕成瓷砖、简一大理石瓷砖、蒙娜丽莎瓷砖。（以上排名不分前后）</view>
   </view>

   <!-- bangdan -->
   <view class="brandlist n_list col_12">

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=12">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2018-12-04/20181204084655.png"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=12">
                   <view class="pp_name">亚细亚瓷砖</view>
                   <view class="pp_con">亚细亚瓷砖诞生于1973年，是集产品研发、生产、营销、服务于一体的全方位高端陶瓷企业。亚细亚瓷砖以绿色化、智能化、集成化的生产理念，不断为全球消费者提供大量优质与品味卓越的产品。亚细亚瓷砖用自己的脚步丈量世界深度，以优质的产品和专注的服务，先后成为全球多个著名地标项目的瓷砖供应商。全新升级终端方案，样板空间展示意境化、经济化，产品展示风格化、方案化展示设计更符合主流高端群体的消费习惯。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=12" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=111">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-25/20200525041740.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=111">
                   <view class="pp_name">大角鹿超耐磨大理石瓷砖</view>
                   <view class="pp_con">大角鹿独创“超耐磨钻石釉”专利技术有效提升大理石瓷砖的耐磨性，大角鹿超耐磨大理石瓷砖，超耐磨，持久新！</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=111" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=25">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-15/20200515110948.png"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=25">
                   <view class="pp_name">金意陶瓷砖</view>
                   <view class="pp_con">金意陶整体空间领航，尊贵生活无疆，风向中国，放眼世界。“尊贵空间，普世共享”，自成立之日起，金意陶陶瓷有限公司即以此立业，“始终坚持国际化”，以全球同步的瓷质饰釉砖（仿古砖），独家提供“瓷砖空间整体解决方案”，矢志不渝兑现“尊贵”承诺，襄助从国内到国外、从家用到工程的无数KITO用户，打造尊贵空间，尊享高质生活。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=25" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=159">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2018-12-18/20181218015138.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=159">
                   <view class="pp_name">金牌亚洲磁砖</view>
                   <view class="pp_con">广东金牌陶瓷有限公司是一家集研发、生产、销售于一体的大型陶瓷企业，主营微晶釉下彩、柔抛大理石、瓷质抛光砖、高级釉面砖等建筑材料，属于广东省民营科技企业</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=159" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=48">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2019-03-30/20190330051411.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=48">
                   <view class="pp_name">汇亚磁砖</view>
                   <view class="pp_con">广东汇亚陶瓷有限公司于1998年创立于南国陶都——佛山,公司自创立之初就确立了"诚信、品质、创新"的企业理念,并将此理念全面、全员、全过程贯彻于公司运营的各个环节,朝着"打造中国建陶标杆企业"的目标坚实迈进。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=48" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=191">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-14/20200514120407.png"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=191">
                   <view class="pp_name">新润成瓷砖</view>
                   <view class="pp_con">1998年，南国陶都佛山，西樵山下，潜心造砖的“新润成”诞生了，永续经营的“严选精神”也悄然种下。作为全国专业生产陶瓷墙地砖的现代化企业之一，自家位于广东佛山，近50万m²的两大现代化花园式生产基地，始终是新润成瓷砖品优物美的严选基础。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=191" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=154">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-20/20200520113816.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=154">
                   <view class="pp_name">东鹏瓷砖</view>
                   <view class="pp_con">广东东鹏控股股份有限公司是世界级的瓷砖、卫浴产品专业制造商和品牌商。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=154" class="joinbtn">加盟</navigator>
