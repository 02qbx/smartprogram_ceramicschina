<view class="content white shadow">
<view class="intro">中国{{strname}}榜是由{{RedirectUrl}}，获得年度{{strname}}榜的品牌有:{{listdata}}。</view>
</view>
<view class="content white shadow pinpaibox">
<view class="boxtop">
<view class="left">{{strname}}</view>
</view>
<view class="pinpailist">
<view class="list" s-for="{{PG_PinpaiData}}" s-for-item="item">
<view class="left imgbox" >
<navigator url="/bangdan/pages/view/view?id={{item.ID}}" >
<image mode="aspectFit" src="https://img1.ceramicschina.com{{item.PinpaiDigest.PinpaiLogo}}"></image>
</navigator>
</view>
<view class="infobox right">
<navigator url="/bangdan/pages/view/view?id={{item.ID}}"  class="pname">{{item.PinpaiDigest.PinpaiName}}</navigator>
<view class="sell">{{item.PinpaiDigest.PinpaiDescription}}</view>
<view>
<navigator url="/bangdan/pages/view/view?id={{item.ID}}"  class="click-btn-s right">点击查看</navigator>
</view>
</view>
</view>  
</view>
</view>
