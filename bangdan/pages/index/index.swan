<view>
    <!-- 在页面中对自定义组件进行引用 -->
    <custom chinaName="中国陶瓷网" engName="Custom title"></custom>
</view>
<view class="container">
    <!-- <import src="/template/BrandsMune/BrandsMune.swan" /> -->

    <view class="darkgrey">
        <view class="banner"><image mode="widthFix" src="https://m.ceramicschina.com/image/bangdan.jpg"></image>
    </view>

    <view class="bdlist">
        <block s-for="{{list}}" s-for-item="item">
             <block s-if="{{enname== item.pinpaitypeenname}}">
        <view class="nav-link on">
            <navigator url="/bangdan/pages/index/index?typename={{item.pinpaitypeenname}}"   hover-class="navigator-hover">{{item.pinpaitypename}}</navigator>
            </view>
            </block>
               <block s-if="{{enname!= item.pinpaitypeenname}}">
        <view class="nav-link">
            <navigator url="/bangdan/pages/index/index?typename={{item.pinpaitypeenname}}"   hover-class="navigator-hover">{{item.pinpaitypename}}</navigator>


        </view></block>
        </block>

    </view>


    <!-- list 陶瓷十大品牌 -->
    <view class="tenbrandint">
        <view class="title">{{strname}}</view>
        <view class="int">{{RedirectUrl}}·{{strname}}”的有：{{listdata}}（以上排名不分前后） </view>
    </view>

    <!-- bangdan -->
    <view class="brandlist n_list col_12">


        <view class="n_con"  s-for="{{PG_PinpaiData}}" s-for-item="item">
            <view class="brandbox vip-icon col_left">
                <navigator url="/bangdan/pages/view/view?id={{item.digestid}}">
                    <image mode="widthFix" src="https://img1.ceramicschina.com{{item.pg_pinpaidigest.pinpailogo}}"></image>
                </navigator>
            </view>
            <view class="col_right">
                <navigator url="/bangdan/pages/view/view?id={{item.digestid}}">
                    <view class="pp_name">{{item.pg_pinpaidigest.pinpainame}}</view>
                    <view class="pp_con">{{item.pg_pinpaidigest.pinpaidescription}}</view>
                </navigator>
                <navigator url="/bangdan/pages/view/view?id={{item.digestid}}" class="joinbtn">详细</navigator>
            </view>
        </view>



    </view>

    <!-- box -->
    <view class="ppbox">
        <view class="title">活动组委</view>
        <view class="intro">
               <view>主办单位：中国陶瓷网</view>
          <view>支持单位：中国建筑装饰协会</view>
            <view>组织单位：中国建筑卫生陶瓷十大品牌榜组委会</view>
            <view>支持媒体：中央电视台、新华社、新浪家居、地产中国网、新浪地产、网易家居、《中国建设报》、《中华建筑报》、《中国房地产报》、《中国质量报》、《中国建材报》、《中国建筑装饰装修》杂志、《陶瓷信息报》、中国建材工业出版社、央视网能源频道、中装新网、中国建材家居网、美丽中国行网等。</view>
        </view>
    </view>

    <view class="ppbox">
        <view class="title">品牌推广联系方式</view>
        <view class="intro">
            <view>电话：400-115-2002 / 0757-82532106</view>
            <view>联系人：谭小姐 </view>
            <view>传真：0757-82532105</view>
            <view>邮箱：cerchn@163.com </view>
            <view>联系地址：佛山市禅城区张槎塱宝西路广东零壹科技园赣商大厦12楼</view>
        </view>
    </view>

    <view class="footer">
        <view>经营许可证编号：粤ICP备14052601号-1</view>
        <view class="foot">&#169;2002-2022 中国陶瓷网All Rights Reserved</view>
    </view>

 </view>

<view class="page-section-btns" bindtap="scrollToTop">
    <view class="ToTop">
        <image mode="widthFix" src="/images/ztw_retopbtn.png" alt="返回顶部"></image>
    </view>
</view>
