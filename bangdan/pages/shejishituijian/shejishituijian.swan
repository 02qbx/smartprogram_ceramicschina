               <navigator url="/bangdan/pages/view/view?id=45">
                   <view class="pp_name">鹰牌陶瓷</view>
                   <view class="pp_con">佛山石湾鹰牌陶瓷有限公司位于中国陶都广东佛山，始建于1974年8月18日，是世界上较具规模的专业化陶瓷企业之一。</view>
