   <view class="brandlist n_list col_12">

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=163">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-14/20200514032530.png"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=163">
                   <view class="pp_name">维罗生态砖</view>
                   <view class="pp_con">维罗生态砖（佛山市阳光陶瓷有限公司）成立于2002年，是广东昊晟企业旗下健康功能性陶瓷标杆品牌。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=163" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
