               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=25">
                   <view class="pp_name">金意陶瓷砖</view>
                   <view class="pp_con">金意陶整体空间领航，尊贵生活无疆，风向中国，放眼世界。“尊贵空间，普世共享”，自成立之日起，金意陶陶瓷有限公司即以此立业，“始终坚持国际化”</view>
               </navigator>
