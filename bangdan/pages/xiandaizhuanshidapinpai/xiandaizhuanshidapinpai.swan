           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=128">
                   <view class="pp_name">强牌陶瓷</view>
                   <view class="pp_con">强牌陶瓷是佛山市金舵陶瓷企业旗下核心品牌，企业拥有20多年陶瓷墙地砖生产经验，拥有佛山和梧州两大生产基地，总占地面积达2000亩，总投资超过15亿元，致力成为具有卓越品质的陶瓷行业智造领跑者。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=128" class="joinbtn">加盟</navigator>
