           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=6476">
                   <view class="pp_name">鹰牌2086</view>
                   <view class="pp_con">鹰牌2086，一个专注于产品与设计的高端现代仿古砖品牌，洞悉新消费时代下的“精神”趋势，创造以现代仿古为主打风格的瓷砖美学，以“产品+设计”来表现现代的生活形态</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=6476" class="joinbtn">加盟</navigator>
           </view>
