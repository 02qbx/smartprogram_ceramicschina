   <!-- list 现代砖十大品牌 -->
   <view class="tenbrandint">
       <view class="title">现代砖十大品牌</view>
       <view class="int">中国现代砖十大品牌榜是由中国陶瓷网和中国建筑装饰协会于2020年6月18日陶瓷品牌日共同线上揭幕，获得年度现代砖十大品牌榜的品牌有:欧文莱|素色瓷砖、YOU&ME尧铭现代砖、布朗尼瓷砖、帕诺特瓷砖、鹰牌2086、金意陶瓷砖、强牌陶瓷、利家居瓷砖。（以上排名不分前后）</view>
   </view>

   <!-- bangdan -->
   <view class="brandlist n_list col_12">

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=7582">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-16/20200516053617.png"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=7582">
                   <view class="pp_name">欧文莱|素色瓷砖</view>
                   <view class="pp_con">广东欧文莱陶瓷有限公司创建于1999年，位于佛山，是集设计、研发、制造、营销为一体的大型瓷砖企业，致力于为消费者提供简约、时尚、高品位的“素色瓷砖”</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=7582" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=6451">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2018-12-21/20181221110321.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=6451">
                   <view class="pp_name">YOU&ME尧铭现代砖</view>
                   <view class="pp_con">YOU&ME尧铭现代砖始于2013年，是一家集设计、生产、营销及服务系统为一体的年轻化瓷砖品牌。总部注册于芬兰赫尔辛基，营销中心设于中国瓷砖之都佛山市，由芬兰独立设计师以及合作设计师为品牌提供创意支持。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=6451" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=7574">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-14/20200514115610.png"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=7574">
                   <view class="pp_name">布朗尼瓷砖</view>
                   <view class="pp_con">布朗尼源自英文Brownies，是英国苏格兰传说中善良活泼的精灵仙子，也是甜美馥郁的美式甜品，引申词Brown，亦是自然万物中代表土壤的色彩，隐喻品牌如大地般具有磅礴的生命力</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=7574" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=7575">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-14/20200514120112.png"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=7575">
                   <view class="pp_name">帕诺特瓷砖</view>
                   <view class="pp_con">帕诺特，源自英文Palette，是艺术家和设计大师创作中不可或缺的灵感调色板，寓意品牌及产品的独特艺术性与创造能力</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=7575" class="joinbtn">加盟</navigator>
