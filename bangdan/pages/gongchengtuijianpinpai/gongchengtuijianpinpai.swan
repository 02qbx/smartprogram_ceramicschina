   <!-- list 工程推荐品牌 -->
   <view class="tenbrandint">
       <view class="title">工程推荐品牌</view>
       <view class="int">中国工程推荐品牌榜是由中国陶瓷网和中国建筑装饰协会于2020年6月18日陶瓷品牌日共同线上揭幕，获得年度工程推荐品牌榜的品牌有:大将军陶瓷、欧神诺陶瓷、威尔斯陶瓷、金舵瓷砖、白兔瓷砖。（以上排名不分前后）</view>
   </view>

   <!-- bangdan -->
   <view class="brandlist n_list col_12">

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=29">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-19/20200519105537.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=29">
                   <view class="pp_name">大将军陶瓷</view>
                   <view class="pp_con">大将军陶瓷，厂区位于高要白土镇宋隆工业园，营销中心位于佛山华夏陶瓷博览城，公司采用全套丝网印花设备和超长新型窑炉，以严格的质保体系、严谨的工作作风和创新精神组织生产，年产销精品瓷砖1000多万平方米。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=29" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=164">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-07-06/20200706104143.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=164">
                   <view class="pp_name">欧神诺陶瓷</view>
                   <view class="pp_con">“欧神诺”来自意大利语“OCEANO”，意为海洋。欧神诺公司意大利著名陶瓷专家从《圣经》“诺亚方舟”动人传说中受到启迪，创造出美丽的、时尚的欧神诺陶瓷品牌。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=164" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=6471">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-16/20200516105118.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=6471">
                   <view class="pp_name">威尔斯陶瓷</view>
                   <view class="pp_con">威尔斯陶瓷始创于2000年，所属的广东宏威陶瓷实业有限公司曾参与制定多项国家及行业标准，是行业内享有盛誉的规模化、现代化的大型建筑陶瓷生产企业，被认定为“国家高新技术企业”。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=6471" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=21">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2018-08-24/20180824101010.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=21">
                   <view class="pp_name">金舵瓷砖</view>
                   <view class="pp_con">金舵瓷砖有限公司位于“中国建陶第一镇”广东省佛山市南庄镇。公司成立于1993年，是顺应“邓公南巡”东风成长起来的民营企业的代表。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=21" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=6455">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2019-03-18/20190318053255.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=6455">
                   <view class="pp_name">白兔瓷砖</view>
                   <view class="pp_con">白兔陶瓷成立于1999年，是一家中国乃至世界较具规模与影响力的现代化大型建筑陶瓷生产经营企业，专业生产销售外墙砖、马赛克、内墙地砖产品，花色品种多达上万个，满足了不同消费需求。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=6455" class="joinbtn">加盟</navigator>
