    <!-- list 陶瓷十大品牌 -->
    <view class="tenbrandint">
        <view class="title">陶瓷十大品牌</view>
        <view class="int">中国陶瓷十大品牌榜是由中国陶瓷网和中国建筑装饰协会于2020年6月18日陶瓷品牌日共同线上揭幕，获得年度陶瓷十大品牌榜的品牌有:鹰牌陶瓷、威尔斯陶瓷、顺辉瓷砖、能强陶瓷、强辉陶瓷、大角鹿超耐磨大理石瓷砖、欧神诺陶瓷、白兔瓷砖、狮王陶瓷、马可波罗磁砖。（以上排名不分前后）</view>
    </view>

    <!-- bangdan -->
    <view class="brandlist n_list col_12">

        <view class="n_con">
            <view class="brandbox vip-icon col_left">
                <navigator url="/bangdan/pages/view/view?id=45">
                    <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-15/20200515105226.jpg"></image>
                </navigator>
            </view>
            <view class="col_right">
                <navigator url="/bangdan/pages/view/view?id=45">
                    <view class="pp_name">鹰牌陶瓷</view>
                    <view class="pp_con">佛山石湾鹰牌陶瓷有限公司位于中国陶都广东佛山，始建于1974年8月18日，是世界上较具规模的专业化陶瓷企业之一。</view>
                </navigator>
                <navigator url="/bangdan/pages/view/view?id=45" class="joinbtn">加盟</navigator>
            </view>
        </view>

        <view class="n_con">
            <view class="brandbox vip-icon col_left">
                <navigator url="/bangdan/pages/view/view?id=6471">
                    <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-16/20200516105118.jpg"></image>
                </navigator>
            </view>
            <view class="col_right">
                <navigator url="/bangdan/pages/view/view?id=6471">
                    <view class="pp_name">威尔斯陶瓷</view>
                    <view class="pp_con">威尔斯陶瓷始创于2000年，所属的广东宏威陶瓷实业有限公司曾参与制定多项国家及行业标准，是行业内享有盛誉的规模化、现代化的大型建筑陶瓷生产企业，被认定为“国家高新技术企业”。威尔斯陶瓷自面市以来，已经成长为目前中国建筑陶瓷界集研发、生产、销售为一体的行业知名品牌。公司率先通过ISO9001质量管理体系认证、ISO14001环境管理体系和OHSAS18001职业健康体系认证，被评为“广东省企业技术中心”、“标准化良好行为AAAA级企业”、“广东省守合同重信用企业”；获得发明专利38项，拥有26项通过权威鉴定的科技创新成果。</view>
                </navigator>
                <navigator url="/bangdan/pages/view/view?id=6471" class="joinbtn">加盟</navigator>
            </view>
        </view>

        <view class="n_con">
            <view class="brandbox vip-icon col_left">
                <navigator url="/bangdan/pages/view/view?id=6470">
                    <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2018-01-24/20180124103546.jpg"></image>
                </navigator>
            </view>
            <view class="col_right">
                <navigator url="/bangdan/pages/view/view?id=6470">
                    <view class="pp_name">顺辉瓷砖</view>
                    <view class="pp_con">顺辉瓷砖隶属于瓷砖制造商佛山高明顺成陶瓷有限公司。自1998年成立以来，秉承“顺动中国”的发展愿景，发扬专业、创新、责任、卓越的精神，致力于为现代人居空间提供优质的瓷砖产品，其生产的陶瓷墙地砖产品尺寸偏差、吸水率、破坏强度、耐磨性、耐污性等主要技术指标均优于国家标准及欧洲标准。顺辉瓷砖开创防伪瓷砖，获得国家专利认证（抗菌专利号：ZL200820047436.6，防伪标识专利号：ZL200820047850.7）。</view>
                </navigator>
                <navigator url="/bangdan/pages/view/view?id=6470" class="joinbtn">加盟</navigator>
            </view>
        </view>

        <view class="n_con">
            <view class="brandbox vip-icon col_left">
                <navigator url="/bangdan/pages/view/view?id=187">
                    <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2015-02-03/20150203013615.jpg"></image>
                </navigator>
            </view>
            <view class="col_right">
                <navigator url="/bangdan/pages/view/view?id=187">
                    <view class="pp_name">能强陶瓷</view>
                    <view class="pp_con">广东能强陶瓷有限公司成立于1999年，生产基地位于中国著名的建陶基地广东佛山，是专业生产“微晶玻璃陶瓷复合板”、“大理石瓷砖 ”、“瓷质喷墨抛光砖”、“通体瓷质仿古砖”、“玻化抛光砖”、“不透水精品瓷片”、“原生木瓷砖”的大规模建陶厂家。</view>
                </navigator>
                <navigator url="/bangdan/pages/view/view?id=187" class="joinbtn">加盟</navigator>
            </view>
        </view>

        <view class="n_con">
            <view class="brandbox vip-icon col_left">
                <navigator url="/bangdan/pages/view/view?id=90">
                    <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2019-10-14/20191014100842.jpg"></image>
                </navigator>
            </view>
            <view class="col_right">
                <navigator url="/bangdan/pages/view/view?id=90">
                    <view class="pp_name">强辉陶瓷</view>
                    <view class="pp_con">广东强辉陶瓷有限公司成立于2002年8月30日，地处南国陶都腹地广东佛山市禅城区南庄镇，是一家专业生产各种规格建筑陶瓷的现代化陶瓷企业。公司资金雄厚，设备先进，全线引进意大利陶瓷自动化生产线，生产出一流的产品。公司拥有专业研发、生产经营管理、市场营销等全方位的高素质人才，从而使企业从产品创意设计、系列产品研发、生产经营到营销能力等方面均在同行中居于行业领先地位。</view>
                </navigator>
                <navigator url="/bangdan/pages/view/view?id=90" class="joinbtn">加盟</navigator>
            </view>
        </view>

        <view class="n_con">
            <view class="brandbox vip-icon col_left">
                <navigator url="/bangdan/pages/view/view?id=111">
                    <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-25/20200525041740.jpg"></image>
                </navigator>
            </view>
            <view class="col_right">
                <navigator url="/bangdan/pages/view/view?id=111">
                    <view class="pp_name">大角鹿超耐磨大理石瓷砖</view>
                    <view class="pp_con">大角鹿独创“超耐磨钻石釉”专利技术有效提升大理石瓷砖的耐磨性，大角鹿超耐磨大理石瓷砖，超耐磨，持久新！</view>
                </navigator>
                <navigator url="/bangdan/pages/view/view?id=111" class="joinbtn">加盟</navigator>
            </view>
        </view>

        <view class="n_con">
            <view class="brandbox vip-icon col_left">
                <navigator url="/bangdan/pages/view/view?id=164">
                    <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-07-06/20200706104143.jpg"></image>
