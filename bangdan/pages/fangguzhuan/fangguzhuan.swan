   <!-- list 仿古砖十大品牌 -->
   <view class="tenbrandint">
       <view class="title">仿古砖十大品牌</view>
       <view class="int">中国仿古砖十大品牌榜是由中国陶瓷网和中国建筑装饰协会共同于2019年4月11日在北京人民大会堂举行评选颁奖活动，获得年度仿古砖十大品牌榜的品牌有: 金意陶瓷砖、马可波罗磁砖、诺贝尔磁砖、L&D陶瓷。</view>
   </view>

   <!-- bangdan -->
   <view class="brandlist n_list col_12">

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=25">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2020-05-15/20200515110948.png"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=25">
                   <view class="pp_name">金意陶瓷砖</view>
                   <view class="pp_con">金意陶整体空间领航，尊贵生活无疆，风向中国，放眼世界。“尊贵空间，普世共享”，自成立之日起，金意陶陶瓷有限公司即以此立业，“始终坚持国际化”，以全球同步的瓷质饰釉砖（仿古砖），独家提供“瓷砖空间整体解决方案”，矢志不渝兑现“尊贵”承诺，襄助从国内到国外、从家用到工程的无数KITO用户，打造尊贵空间，尊享高质生活。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=25" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=174">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2015-02-02/20150202053246.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=174">
                   <view class="pp_name">马可波罗磁砖</view>
                   <view class="pp_con">马可波罗瓷砖，企业创立于1988年，品牌诞生于1996年。作为国内最早品牌化、产品系列最全最大的建陶品牌，是多家设计院战略合作品牌及奥运亚运世博会等大型工程建设的主要建材供应品牌。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=174" class="joinbtn">加盟</navigator>
           </view>
       </view>

       <view class="n_con">
           <view class="brandbox vip-icon col_left">
               <navigator url="/bangdan/pages/view/view?id=173">
                   <image mode="widthFix" src="https://img1.ceramicschina.com/Upfiles/2019-08-13/20190813020943.jpg"></image>
               </navigator>
           </view>
           <view class="col_right">
               <navigator url="/bangdan/pages/view/view?id=173">
                   <view class="pp_name">诺贝尔瓷砖</view>
                   <view class="pp_con">杭州诺贝尔集团有限公司是一家外资企业，于1992年在杭州成立，以人性化的“诺贝尔”产品不断创造完美的品质空间。</view>
               </navigator>
               <navigator url="/bangdan/pages/view/view?id=173" class="joinbtn">加盟</navigator>
           </view>
       </view>

