<view class="content white shadow pinpaibox" ><view class="boxtop"><view class="left">陶瓷十大品牌</view><navigator url="/bangdan/pages/taocishidapinpai/taocishidapinpai" class="right" >>></navigator></view>

<view class="pinpailist">
<view class="list" s-for="{{PG_PinpaiData}}" s-for-item="item">
<view class="left imgbox" >
<navigator url="/bangdan/pages/view/view?id={{item.id}}" >
<image mode="aspectFit" src="https://img1.ceramicschina.com{{item.pg_pinpaidigest.pinpailogo}}"></image>
</navigator>
</view>
<view class="infobox right">
<navigator url="/bangdan/pages/view/view?id={{item.id}}"  class="pname">{{item.pg_pinpaidigest.pinpainame}}</navigator>
<view class="sell">{{item.pg_pinpaidigest.pinpaidescription}}</view>
<view>
<navigator url="/bangdan/pages/view/view?id={{item.id}}"  class="click-btn-s right">点击查看</navigator>
</view>
</view>
</view>

</view></view>
